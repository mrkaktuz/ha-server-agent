# Dim Server Agent за nginx + Cloudflare.
# 1) У Cloudflare: запис agent.<домен> → цей сервер, проксі увімкнено (помаранчева хмарка).
#    Бажано ще правило WAF: дозволити лише домашню IP-адресу для agent.<домен>.
# 2) Сертифікат — як для інших сайтів сервера (Cloudflare Origin або Let's Encrypt).
# 3) Скопіювати в /etc/nginx/sites-available/dim-agent, увімкнути (ln -s у sites-enabled) → sudo nginx -t && sudo systemctl reload nginx
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name agent.example.com;

    ssl_certificate     /etc/ssl/cloudflare/example.com.pem;
    ssl_certificate_key /etc/ssl/cloudflare/example.com.key;

    # Лише запити через Cloudflare (адреси: https://www.cloudflare.com/ips/), напр.:
    # include /etc/nginx/snippets/cloudflare-only.conf;

    client_max_body_size 16k;

    location /v1/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Агент бере справжню адресу клієнта з цього заголовка (Cloudflare ставить його сам)
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_read_timeout 120s;
    }

    location / { return 404; }
}
